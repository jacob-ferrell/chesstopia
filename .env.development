VITE_ORIGIN=https://jacob-ferrell.github.io/chesstopia
# Leave VITE_SERVER empty so the app uses same-origin /api and /websocket,
# which the Vite dev server proxies to VITE_PROXY_TARGET (see vite.config.ts).
# Override the target per machine in .env.development.local (gitignored).
VITE_SERVER=
VITE_PROXY_TARGET=http://localhost:8080
